name: "vae"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "sample"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1]
  }
]
output [
  {
    name: "latent_sample"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1]
  }
]

instance_group [
  {
    kind: KIND_GPU
  }
]

optimization {
  graph : {
    level : 1
  }
}

parameters { key: "execution_mode" value: { string_value: "1" } }
parameters { key: "cudnn_conv_algo_search" value: { string_value: "0" } }