name: "unet"
platform: "tensorrt_plan"
max_batch_size : 0

input [
  {
    name: "sample"
    data_type: TYPE_FP32
    dims: [ -1, 9, 128, 128 ]
  },
  {
    name: "timestep"
    data_type: TYPE_FP32
    dims: [-1]
  },
  {
    name: "encoder_hidden_states"
    data_type: TYPE_FP32
    dims: [ -1, 77, 2048 ]
  },
  {
    name: "text_embeds"
    data_type: TYPE_FP32
    dims: [ -1, 1280 ]
  },
  {
    name: "time_ids"
    data_type: TYPE_FP32
    dims: [ -1, 6 ]
  }
]
output [
  {
    name: "out_sample"
    data_type: TYPE_FP32
    dims: [ -1, 4, -1, -1 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
  }
]

optimization {
  execution_accelerators {
    gpu_execution_accelerator {
      name: "tensorrt"
    }
  }
  graph {
    level: 1
  }
}

parameters: {
  key: "TF_ENABLE_TENSORRT"
  value: { string_value: "1" }
}