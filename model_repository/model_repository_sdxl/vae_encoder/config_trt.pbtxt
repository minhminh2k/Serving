name: "vae_encoder"
platform: "tensorrt_plan"
max_batch_size: 0

input [
  {
    name: "sample"
    data_type: TYPE_FP32
    dims: [ -1, 3, -1, -1]
  }
]
output [
  {
    name: "latent_sample"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1]
  }
]

instance_group [
  {
    kind: KIND_GPU
  }
]

optimization {
  execution_accelerators {
    gpu_execution_accelerator {
      name: "tensorrt"
    }
  }
  graph {
    level: 1
  }
}

parameters: {
  key: "TF_ENABLE_TENSORRT"
  value: { string_value: "1" }
}